.sub2-page{background-color:#fff7e6;border-radius:8rpx;margin:10rpx;padding:15rpx}.sub2-page .header{margin-bottom:10rpx}.sub2-page .header .title{color:#d46b08;font-size:18rpx;font-weight:700}.sub2-page .actions{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;gap:10rpx;margin-bottom:10rpx}.sub2-page .status{color:#666;display:block;font-size:13rpx;margin-bottom:10rpx}.sub2-page .deep-case{background:-webkit-gradient(linear,left top,left bottom,from(#fff7e6),to(#ffe7ba));background:-webkit-linear-gradient(top,#fff7e6,#ffe7ba);background:linear-gradient(180deg,#fff7e6,#ffe7ba);border:2rpx solid #ffd591;border-radius:8rpx;margin-bottom:10rpx;padding:12rpx}.sub2-page .deep-case .deep-case-title{color:#ad4e00;display:block;font-size:15rpx;font-weight:700;margin-bottom:6rpx}.sub2-page .deep-case .deep-case-note{color:#874d00;display:block;font-size:12rpx;line-height:1.5;margin-bottom:8rpx}.sub2-page .deep-case .deep-node{background:hsla(0,0%,100%,.72);border:2rpx dashed rgba(212,107,8,.35);border-radius:8rpx;margin-top:8rpx;padding:10rpx}.sub2-page .deep-case .deep-node .deep-title{color:#d46b08;display:block;font-size:13rpx;font-weight:800;margin-bottom:6rpx}.sub2-page .deep-case .deep-node .deep-copy{color:#7a4b17;font-size:12rpx;line-height:1.5}.sub2-page .deep-case .deep-node.deep-leaf{background:#fff;border-color:rgba(173,78,0,.55);-webkit-box-shadow:inset 6rpx 0 0 #d46b08;box-shadow:inset 6rpx 0 0 #d46b08}.sub2-page .deep-case .level-0{margin-left:0}.sub2-page .deep-case .level-1{margin-left:12rpx}.sub2-page .deep-case .level-2{margin-left:24rpx}.sub2-page .deep-case .level-3{margin-left:36rpx}.sub2-page .deep-case .level-4{margin-left:48rpx}.sub2-page .deep-case .level-5{margin-left:60rpx}
