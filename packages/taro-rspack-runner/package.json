{
  "name": "@tarojs/rspack-runner",
  "version": "4.2.1",
  "description": "Taro H5 Rspack build tool (experimental)",
  "author": "dongweb",
  "license": "MIT",
  "main": "index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prod": "pnpm run build",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:dev": "vitest",
    "test:update": "vitest --update"
  },
  "files": [
    "index.js",
    "dist"
  ],
  "keywords": [
    "taro",
    "rspack",
    "h5"
  ],
  "bugs": {
    "url": "https://github.com/NervJS/taro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NervJS/taro.git"
  },
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@rspack/core": "1.2.8",
    "@tarojs/helper": "workspace:*",
    "@tarojs/taro-loader": "workspace:*",
    "autoprefixer": "^10.4.19",
    "css-loader": "^7.1.1",
    "lodash": "^4.17.21",
    "postcss": "^8.4.38",
    "postcss-html-transform": "workspace:*",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-plugin-constparse": "workspace:*",
    "postcss-pxtransform": "workspace:*",
    "postcss-url": "^10.1.3",
    "sass-loader": "^14.2.1"
  },
  "devDependencies": {
    "@tarojs/service": "workspace:*",
    "@tarojs/taro": "workspace:*",
    "@types/lodash": "^4.17.0",
    "sass": "^1.75.0"
  },
  "peerDependencies": {
    "sass": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  }
}
