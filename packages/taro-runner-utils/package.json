{
  "name": "@tarojs/runner-utils",
  "version": "4.3.3",
  "description": "Taro runner utilities.",
  "author": "O2Team",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundler/*.d.ts": "./dist/bundler/*.d.ts",
    "./bundler/*.js": {
      "types": "./dist/bundler/*.d.ts",
      "default": "./dist/bundler/*.js"
    },
    "./bundler/*": {
      "types": "./dist/bundler/*.d.ts",
      "default": "./dist/bundler/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "bundler/*.d.ts": [
        "./dist/bundler/*.d.ts"
      ],
      "bundler/*.js": [
        "./dist/bundler/*.d.ts"
      ],
      "bundler/*": [
        "./dist/bundler/*.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prod": "pnpm run build",
    "build": "tsc",
    "dev": "tsc -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NervJS/taro.git"
  },
  "keywords": [
    "taro"
  ],
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@tarojs/helper": "workspace:*",
    "@tarojs/shared": "workspace:*",
    "lodash": "^4.17.21",
    "rollup": "^3.29.4",
    "scss-bundle": "^3.1.2"
  },
  "devDependencies": {
    "@tarojs/taro": "workspace:*",
    "@types/detect-port": "^1.3.5",
    "@types/lodash": "^4.17.0",
    "@types/sax": "^1.2.4",
    "autoprefixer": "^10.4.19",
    "detect-port": "^1.5.1",
    "html-minifier": "^4.0.0",
    "jsdom": "^24.0.0",
    "loader-utils": "^3.2.1",
    "miniprogram-simulate": "^1.6.1",
    "ora": "^5.4.1",
    "picomatch": "^4.0.2",
    "postcss": "^8.4.38",
    "postcss-html-transform": "workspace:*",
    "postcss-import": "^16.1.0",
    "postcss-plugin-constparse": "workspace:*",
    "postcss-pxtransform": "workspace:*",
    "postcss-url": "^10.1.3",
    "sax": "1.2.4",
    "tapable": "^2.2.1",
    "vm2": "^3.9.19",
    "webpack-format-messages": "^3.0.1"
  },
